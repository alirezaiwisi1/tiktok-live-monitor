# Telegram notifications (create a bot with @BotFather) — optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Delay between reconnect attempts (milliseconds)
RECONNECT_DELAY_MS=30000

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# API port
PORT=3000

# CORS: comma-separated list of allowed website origins (no trailing slash).
# Example: WEBSITE_ORIGIN=https://my-site.onrender.com,https://my-site.netlify.app
# If unset, CORS is open to all origins (fine for testing; set it in production).
WEBSITE_ORIGIN=
